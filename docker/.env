# DeepSeek API密钥
DEEPSEEK_API_KEY=

# Redis密码（留空表示无密码）
REDIS_PASSWORD=

# Neo4j知识图谱配置
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123
NEO4J_DATABASE=neo4j

# DeepSeek模型
DEEPSEEK_MODEL=deepseek-v4-flash

# GraphRAG配置
GRAPHRAG_ENABLED=true
RETRIEVAL_STRATEGY=hybrid_graph  # hybrid, vector_only, bm25_only, graph_only, hybrid_graph
GRAPH_RETRIEVAL_WEIGHT=0.2  # 图检索权重（语义0.5 + BM25 0.3 + 图0.2）